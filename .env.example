# ==============================================================================
#  Traffic Law GraphRAG - Environment Configuration Example
# ==============================================================================
#  Hướng dẫn:
#  1. Sao chép file này thành .env: cp .env.example .env
#  2. Điền các API Key và cấu hình tương ứng với môi trường của bạn.
#  3. Các trường API_KEYS hỗ trợ nhiều key cách nhau bằng dấu phẩy để tự động xoay key.

# 1. CƠ SỞ DỮ LIỆU ĐỒ THỊ NEO4J (BẮT BUỘC)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# 2. CLOUD LLM API KEYS (MULTI-PROVIDER FAILOVER)

# --- Google Gemini (https://aistudio.google.com) ---
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_API_KEY=your_gemini_api_key_1

# --- Groq Cloud (https://console.groq.com) ---
GROQ_API_KEYS=gsk_your_groq_api_key_1
GROQ_API_KEY=gsk_your_groq_api_key_1

# --- Cerebras Cloud (https://cloud.cerebras.ai) ---
CEREBRAS_API_KEYS=csk_your_cerebras_api_key_1
CEREBRAS_API_KEY=csk_your_cerebras_api_key_1

# --- Cohere (https://dashboard.cohere.com) ---
COHERE_API_KEYS=your_cohere_api_key_1
COHERE_API_KEY=your_cohere_api_key_1

# ==============================================================================
# 3. THỨ TỰ ƯU TIÊN VÀ MODEL CỦA TỪNG NHÀ CUNG CẤP
LLM_PROVIDER_ORDER=groq,cerebras,cohere,gemini

# Tên mô hình chỉ định cho từng nhà cung cấp (tùy chọn, để trống sẽ dùng mặc định)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=llama-3.3-70b
COHERE_MODEL=command-r-08-2024

# Endpoint API tương ứng (thường giữ mặc định)
GROQ_ENDPOINT=https://api.groq.com/openai/v1
CEREBRAS_ENDPOINT=https://api.cerebras.ai/v1
COHERE_ENDPOINT=https://api.cohere.ai/compatibility/v1


