          "implicit": true,
          "instruction": "2. Sửa đổi, bổ sung khoản 2 Điều 7 như sau:"
        },
        "replacement_root_level": "CLAUSE",
        "replacement_tree": {
          "clause": {
            "number": "2",
            "content": "2. Bộ Giáo dục và Đào tạo tổ chức hoạt động dạy học kiến thức pháp luật về trật tự, an toàn giao thông đường bộ cho trẻ em mầm non, học sinh tiểu học, trung học cơ sở, trung học phổ thông, cơ sở giáo dục nghề nghiệp; đưa nội dung chấp hành pháp luật về trật tự, an toàn giao thông đường bộ là một trong những tiêu chí đánh giá, xếp loại hạnh kiểm đối với học sinh.",
            "points": []
          }
        },
